{
  "name": "publisher-content-discovery-widget",
  "private": true,
  "version": "0.1.0",
  "description": "Reusable multi-publisher AI-ready content discovery widget foundation.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.widget.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "publisher:create": "node scripts/publisher-create.mjs",
    "publisher:check": "node scripts/publisher-check.mjs",
    "publisher:embed": "node scripts/publisher-embed.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  }
}
