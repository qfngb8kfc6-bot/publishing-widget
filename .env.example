# Public/browser-safe routing only. Keep private credentials out of this file and out of widget.js.
# The scalable server convention is PUBLISHER_<PUBLISHER_ID>_<FIELD>, for example:
# PUBLISHER_ACME_MEDIA_API_KEY=server-only-secret
# PUBLISHER_ACME_MEDIA_BASE_URL=https://api.example.com
REAL_PUBLISHER_API_BASE_URL=/api/publishers/real-publisher
REAL_PUBLISHER_SEARCH_ENDPOINT=/search
REAL_PUBLISHER_ARTICLE_ENDPOINT=/articles/:id
REAL_PUBLISHER_AUTH_MODE=server-proxy
REAL_PUBLISHER_SEARCH_QUERY_PARAMETER=q
REAL_PUBLISHER_PAGE_PARAMETER=page
REAL_PUBLISHER_LIMIT_PARAMETER=limit
REAL_PUBLISHER_CANDIDATE_LIMIT=30
REAL_PUBLISHER_TIMEOUT_MS=8000

# Server-only, not consumed by the browser bundle:
# REAL_PUBLISHER_API_TOKEN=replace-on-the-server-only

# Server startup should call validatePublisherServerConfig for every production
# manifest using server-only environment variables. Never expose API_KEY values
# through Vite, browser config, analytics or debug events.

# Optional server-side AI layer. Keep AI_API_KEY server-only.
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_MODEL=configured-server-model
AI_ENDPOINT=/api/ai
AI_RERANK_LIMIT=12
AI_EXPLANATIONS_ENABLED=true
AI_TIMEOUT_MS=4500
AI_DETERMINISTIC_WEIGHT=0.7
AI_SEMANTIC_WEIGHT=0.3
# AI_API_KEY=replace-on-the-server-only
